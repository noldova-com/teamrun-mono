{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.noldova.teamrun",
  "productName": "TeamRun",
  "copyright": "Copyright (c) Noldova",
  "directories": {
    "app": "_build/app",
    "output": "_build/package"
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/node-pty/**"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "toolsets": {
    "appimage": "1.0.3"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "assets/icons",
      "to": "assets/icons",
      "filter": [
        "*.png",
        "*.ico"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "artifactName": "TeamRun-windows-${arch}.${ext}",
    "icon": "assets/icons/icon-dark.ico",
    "signExecutable": false,
    "signExts": [
      ".dll",
      ".node"
    ],
    "signtoolOptions": {
      "sign": "./scripts/packaging/windows-sign-hook.ts",
      "signingHashAlgorithms": [
        "sha256"
      ]
    }
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "TeamRun-mac-${arch}.${ext}",
    "icon": "assets/icons/icon-dock-512.png",
    "type": "distribution",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "TeamRun-linux-${arch}.${ext}",
    "description": "AI coding agents working as a team.",
    "executableName": "teamrun",
    "executableArgs": [],
    "extraFiles": [
      {
        "from": "_build/appimage/${arch}/AppRun",
        "to": "AppRun"
      }
    ],
    "icon": "assets/icons/icon-dark-512.png",
    "category": "Development"
  },
  "appImage": {
    "compression": "gzip"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "TeamRun-windows-${arch}.${ext}"
  }
}
